# Copy to .env. Fill only the provider you use; keep secrets on the backend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

DEFAULT_LLM_PROVIDER=openai
# Empty uses the selected provider's default; otherwise use a model available to your account.
DEFAULT_MODEL_NAME=
LLM_TIMEOUT_SECONDS=90
# Optional provider endpoint overrides, e.g. OPENAI_BASE_URL. Standard HTTP(S)_PROXY is supported.

# News and web evidence. Missing key returns unavailable, never mock results.
TAVILY_API_KEY=
# demo = CoinGecko public/Demo API, pro = Pro API; this setting is NOT application demo mode.
COINGECKO_PLAN=demo
COINGECKO_API_KEY=

# Explicit application demonstration mode. Graph skips model conclusions in this mode.
DEMO_MODE=false
RESEARCH_DB_PATH=outputs/research.sqlite3

# Existing standalone notification services (not exposed to model/API).
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
